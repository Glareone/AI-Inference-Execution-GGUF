<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Only project allowed to set this. The LibraryImport source generator (Apple Accelerate
         P/Invoke) fails with SYSLIB1062 without it. No hand-written unsafe blocks.
         See docs/architecture/261101-apple-silicon-acceleration-strategy.md and
         .claude/rules/unsafe-policy.md. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\InferenceEngine.Core\InferenceEngine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="InferenceEngine.Models.Tests" />
  </ItemGroup>

</Project>
